; Plantilla de configuración para el worker de parsedmarc (Fase 4 del plan de
; monitoreo continuo). Copiar a `parsedmarc.ini` y completar con las
; credenciales reales, o usar las variables de entorno PARSEDMARC_SECCION_CLAVE
; en su lugar (recomendado en Railway, para no commitear credenciales).
;
; Documentación completa: https://domainaware.github.io/parsedmarc/
; Antes de cambiar algo acá, confirmar la sintaxis exacta contra esa
; documentación — no asumir opciones que no estén confirmadas ahí.

[general]
save_aggregate = True
; save_failure: ingiere también los reportes forenses (RUF) además de los agregados (RUA). En
; parsedmarc 10.x la clave se renombró de "save_forensic" a "save_failure" (que sigue funcionando
; como alias por compatibilidad, pero usar la nueva evita el warning de deprecación).
save_failure = True

[mailbox]
; watch=True usa IMAP IDLE: reacciona casi al instante cuando llega un
; reporte nuevo, en vez de hacer polling. Este proceso debe correr como
; servicio de larga duración (Worker en Railway), no como cron.
watch = True
; reports_folder NUNCA debe ser "INBOX" si esta casilla también recibe correo real (de trabajo o
; personal) — parsedmarc mueve/borra automáticamente TODO lo que encuentre ahí, incluido lo que no
; sea un reporte DMARC válido (así se movió/perdió correo real una vez, ver README.md). La casilla
; tiene que ser dedicada, o si no se puede, crear un filtro que etiquete solo los reportes reales
; (ej. por "to:" la dirección exacta de rua=/ruf=) y apuntar acá a esa etiqueta aislada.
reports_folder = DMARC-Reports
archive_folder = Archive
; delete: sólo seguro si reports_folder de arriba ya es una etiqueta aislada (ver comentario
; arriba) — el reporte ya queda guardado en la base al procesarse, no hace falta conservar el
; correo original ni acumular subcarpetas de archivo (Archive/Aggregate, Archive/Failure, etc.).
delete = True

[imap]
host = imap.zoho.com
port = 993
ssl = True
user = reports@tudominio.com
password =

[webhook]
; El secreto va en la URL (no en un header) porque no está confirmado que
; parsedmarc permita agregar headers custom al webhook — ver ruta
; /webhooks/dmarc-aggregate/<secret> en app.py, que valida ese secreto.
aggregate_url = https://tu-app.up.railway.app/webhooks/dmarc-aggregate/CAMBIAR_POR_DMARC_WEBHOOK_SECRET
; failure_url: reportes forenses (RUF). En parsedmarc 10.x la clave se renombró de "forensic_url" a
; "failure_url" (el nombre viejo sigue funcionando como alias). Mismo DMARC_WEBHOOK_SECRET que
; aggregate_url arriba -- es el mismo secreto de la app web, solo cambia el path.
failure_url = https://tu-app.up.railway.app/webhooks/dmarc-forensic/CAMBIAR_POR_DMARC_WEBHOOK_SECRET
