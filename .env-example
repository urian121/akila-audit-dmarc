FLASK_DEBUG=true

# Login
SECRET_KEY=

# OpenAI (opcional)
OPENAI_PROJECT_API_KEY=

# Postgres (obligatoria)
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

DMARC_REPORTS_MAILBOX=reports@tudominio.com
DMARC_WEBHOOK_SECRET=

# Vigilancia DNS periódica (jobs/recheck_domains.py, programada con APScheduler en app.py)
RECHECK_DOMAINS_INTERVAL_HOURS=12

# Desactivación de dominios con plan vencido (jobs/deactivate_expired_trials.py)
CHECK_TRIALS_INTERVAL_HOURS=6

# SMTP (alertas)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Worker de parsedmarc (servicio aparte, no esta app)
PARSEDMARC_GENERAL_SAVE_AGGREGATE=True
PARSEDMARC_GENERAL_SAVE_FAILURE=True
PARSEDMARC_MAILBOX_WATCH=True
# REPORTS_FOLDER: NUNCA "INBOX" si la casilla también recibe correo real (de trabajo/personal) —
# parsedmarc lee/mueve/borra todo lo que encuentre ahí, incluido lo que no sea un reporte DMARC.
# Crear un filtro en la casilla que etiquete solo los reportes reales (ej. por "to:" la dirección
# exacta de DMARC_REPORTS_MAILBOX) y apuntar acá a esa etiqueta aislada — ver README.md.
PARSEDMARC_MAILBOX_REPORTS_FOLDER=DMARC-Reports
# TEST=True: no mueve ni borra ningún correo, queda tal cual en REPORTS_FOLDER — seguro porque la
# ingesta (services/reports_service.py, services/forensic_reports_service.py) es idempotente por
# report_id/message_id, así que reprocesar el mismo correo no duplica nada en la base.
PARSEDMARC_MAILBOX_TEST=True
PARSEDMARC_MAILBOX_ARCHIVE_FOLDER=Archive
PARSEDMARC_IMAP_HOST=imap.gmail.com
PARSEDMARC_IMAP_PORT=993
PARSEDMARC_IMAP_SSL=True
PARSEDMARC_IMAP_USER=
PARSEDMARC_IMAP_PASSWORD=
PARSEDMARC_WEBHOOK_AGGREGATE_URL=https://akila-dmarc-production.up.railway.app/webhooks/dmarc-aggregate/<DMARC_WEBHOOK_SECRET real>
PARSEDMARC_WEBHOOK_FAILURE_URL=https://akila-dmarc-production.up.railway.app/webhooks/dmarc-forensic/<DMARC_WEBHOOK_SECRET real>
